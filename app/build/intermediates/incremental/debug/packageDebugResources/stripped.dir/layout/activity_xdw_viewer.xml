<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:background="#CC1565C0"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← Quay lại"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="middle"
            android:singleLine="true"
            android:gravity="center"
            android:paddingHorizontal="4dp" />

        <View
            android:layout_width="60dp"
            android:layout_height="1dp"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- Content Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="112dp"
            android:src="@drawable/ic_xdw"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tài liệu .xdw được đọc bằng ứng dụng DocuWorks Viewer bên ngoài."
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnOpenDocuWorks"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="🚀 Mở lại DocuWorks Viewer"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:paddingHorizontal="24dp"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

    <!-- Bottom nav -->
    <LinearLayout
        android:id="@+id/layoutNav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="#CC1A1A1A"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrevFile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:text="◀ File trước"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            style="@style/Widget.MaterialComponents.Button" />

        <Button
            android:id="@+id/btnNextFile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:text="File tiếp theo ▶"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

</RelativeLayout>
